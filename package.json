{
  "name": "pi-sub-gate",
  "version": "0.6.0",
  "private": true,
  "description": "pi-gate (multi-scope permission gate) and pi-subagent (single blocking delegation tool) for pi",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "permissions",
    "subagent"
  ],
  "pi": {
    "extensions": ["pi-gate/index.ts", "pi-subagent/index.ts"]
  },
  "files": [
    "pi-gate",
    "pi-subagent",
    "!**/__tests__"
  ]
}
