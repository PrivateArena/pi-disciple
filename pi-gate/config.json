{
  "gate": {
    "enabled": true,
    "reviewLog": false,
    "promptTimeoutMs": 0,
    "permission": {
      "*": "ask",
      "read": "allow",
      "write": "allow",
      "edit": "allow",
      "grep": "allow",
      "find": "allow",
      "ls": "allow",
      "path": {
        "*": "allow",
        "*.env": "deny",
        "*.env.*": "deny",
        "*.env.example": "allow",
        "*.pem": "deny",
        "*.key": "deny",
        "*id_rsa*": "deny"
      },
      "external_directory": "ask",
      "bash": {
        "*": "ask"
      },
      "subagent": "allow"
    },
    "grants": {
      "global": [],
      "project": []
    }
  },
  "subagent": {
    "enabled": true,
    "model": "inherit",
    "defaultRole": "explore",
    "delegationPrompt": true,
    "askToExtend": true,
    "maxTurns": 30,
    "timeoutMinutes": 20,
    "maxResultBytes": 65536,
    "keepTranscripts": 20,
    "roles": {
      "general-purpose": {
        "maxTurns": 40,
        "timeoutMinutes": 20
      },
      "explore": {
        "maxTurns": 30,
        "timeoutMinutes": 20
      },
      "review": {
        "maxTurns": 30,
        "timeoutMinutes": 20
      }
    }
  }
}
